{
  "name": "mindcare-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run tokens && vite",
    "dev:mock": "npm run tokens && vite --mode mock",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint . --quiet",
    "format": "prettier --write .",
    "test": "vitest",
    "gen:api": "node scripts/gen-api.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "e2e": "playwright test",
    "size": "size-limit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "~5.9.2",
    "@stomp/stompjs": "~7.3.0",
    "@tanstack/react-query": "~5.104.5",
    "axios": "~1.20.0",
    "dayjs": "~1.11.23",
    "firebase": "~13.1.0",
    "pretendard": "~1.3.9",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-hook-form": "~7.91.0",
    "react-router": "~8.5.1",
    "recharts": "~3.10.1",
    "web-vitals": "~5.3.0",
    "zod": "~4.6.7",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@size-limit/file": "~12.1.0",
    "@tailwindcss/vite": "~4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.10",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "eslint": "~10.13.0",
    "eslint-plugin-import-x": "~4.18.1",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "^17.14.0",
    "husky": "~9.1.7",
    "jsdom": "~27.4.0",
    "lint-staged": "~16.4.0",
    "msw": "~2.15.0",
    "openapi-typescript": "~7.13.0",
    "prettier": "~3.9.10",
    "size-limit": "~12.1.0",
    "tailwindcss": "~4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "typescript-native": "npm:typescript@~7.0.2",
    "vite": "~8.3.8",
    "vitest": "~5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --quiet",
      "prettier --check"
    ],
    "*.{json,css,md,mjs,js,yml}": "prettier --check"
  },
  "size-limit": [
    {
      "name": "첫 화면 JS (랜딩·로그인)",
      "path": "dist/assets/index-*.js",
      "limit": "200 KB",
      "gzip": true
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
