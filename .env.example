# 브라우저에 노출되는 공개값만 둔다 (TRD 7-3). 비밀값은 여기에 넣지 않는다.
# 로컬은 이 파일을 .env.local 로 복사해서 쓴다.

# local / preview / staging / prod — 환경 배지와 분석 이벤트 구분
VITE_APP_ENV=local
VITE_API_BASE_URL=https://15.165.13.247.sslip.io/v1
# STOMP 엔드포인트
VITE_WS_URL=wss://15.165.13.247.sslip.io/ws
# 1이면 MSW 목으로 동작한다 (백엔드와 Firebase 없이 개발)
VITE_API_MOCK=0

# Firebase 웹 앱 설정 (공개값)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# 웹 푸시용
VITE_FIREBASE_VAPID_KEY=

# 에러 수집 (선택)
VITE_SENTRY_DSN=

# 타입 생성 소스 (npm run gen:api). 로컬 백엔드면 http://localhost:8080/v1/openapi.json
OPENAPI_URL=https://15.165.13.247.sslip.io/v1/openapi.json
